{
  "name": "sinewave",
  "shader": "sinewave.wgsl",
  "uniforms": [
    { "name": "scale",     "type": "float", "min": 0.5,  "max": 8.0,  "default": 3.0,  "step": 0.01 },
    { "name": "warp",      "type": "float", "min": 0.0,  "max": 2.0,  "default": 0.8,  "step": 0.01 },
    { "name": "speed",     "type": "float", "min": 0.0,  "max": 3.0,  "default": 1.0,  "step": 0.01 },
    { "name": "color_mix", "type": "float", "min": 0.0,  "max": 1.0,  "default": 0.3,  "step": 0.01 },
    { "name": "octaves",   "type": "int",   "min": 1,    "max": 7,    "default": 4,    "step": 1    },
    { "name": "col_a",     "type": "color", "default": [0.02, 0.02, 0.08] },
    { "name": "col_b",     "type": "color", "default": [0.10, 0.60, 0.90] },
    { "name": "col_c",     "type": "color", "default": [1.00, 0.90, 0.30] }
  ]
}
